# RareRoles Environment Variables

# ================================
# SUPABASE CONFIGURATION
# ================================
# Get these from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_anon_key_here

# ================================
# CLOUDINARY CONFIGURATION (CV Uploads)
# ================================
# Get these from: https://cloudinary.com/console
# Step 1: Go to Dashboard > Settings > Upload
# Step 2: Scroll to "Upload presets"
# Step 3: Click "Add upload preset"
# Step 4: Set signing mode to "Unsigned"
# Step 5: Copy the preset name
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ================================
# GOOGLE APPS SCRIPT WEBHOOK
# ================================
# Step 1: Create Google Spreadsheet
# Step 2: Extensions > Apps Script
# Step 3: Copy code from google-apps-script-webhook.gs
# Step 4: Deploy as Web App
# Step 5: Copy the deployment URL here
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Step 6: In Apps Script > Project Settings > Script Properties
# Step 7: Add property: SECRET_KEY = your_secret_here
# Step 8: Copy the same secret here
VITE_GOOGLE_APPS_SCRIPT_SECRET=your_secret_key_here

# ================================
# FEATURE FLAGS
# ================================
# Enable/disable Google Sheets backup (set to 'false' to disable)
VITE_ENABLE_GOOGLE_BACKUP=true

# Enable/disable retry logic for failed requests
VITE_ENABLE_RETRY_LOGIC=true

# Maximum number of retry attempts for failed API calls
VITE_MAX_RETRY_ATTEMPTS=3

# ================================
# ANALYTICS (OPTIONAL)
# ================================
# Google Analytics tracking ID
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ================================
# DEVELOPMENT
# ================================
# Set to 'development' for verbose logging
NODE_ENV=production
